# Copie para android/keystore.properties e preencha com os dados privados da sua chave.
# Este arquivo de exemplo não contém segredos e pode ser versionado.
storeFile=/caminho/privado/side-of-death-upload-keystore.jks
storePassword=COLOQUE_A_SENHA_DO_KEYSTORE
keyAlias=sideofdeath-upload
keyPassword=COLOQUE_A_SENHA_DA_CHAVE
